# SevaSetu on-premises datacenter configuration
# Copy to .env and fill values. Never commit real secrets.

APP_NAME=SevaSetu
APP_DOMAIN=abcyz.in
APP_PORT=8080
API_PORT=3001
NODE_ENV=production
PUBLIC_URL=https://abcyz.in

# SQLite path (default on-prem). For PostgreSQL set DATABASE_URL.
DATABASE_PATH=/data/sevasetu.db
# DATABASE_URL=postgres://sevasetu:change-me@postgres:5432/sevasetu

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h
SESSION_SECRET=change-this-session-secret

# Super admin bootstrap (used only if database is empty)
BOOTSTRAP_ADMIN_EMAIL=admin@abcyz.in
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe_Admin_123

# SMTP (leave blank to log emails in datacenter mail spool / console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@abcyz.in
EMAIL_PROVIDER=smtp

# Payment providers (configure in Admin > Settings; never expose secrets to frontend)
PAYMENT_PROVIDER=offline
RAZORPAY_KEY=
RAZORPAY_SECRET=
STRIPE_KEY=
STRIPE_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# Storage: local (datacenter disk) | s3 | azure | gcs | r2
STORAGE_PROVIDER=local
STORAGE_PATH=/data/uploads
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
S3_BUCKET=
S3_REGION=ap-south-1
AZURE_STORAGE_CONNECTION=
GCS_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMS / WhatsApp (optional future)
SMS_PROVIDER=
SMS_API_KEY=
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=

# Backup
BACKUP_PATH=/data/backups
BACKUP_RETENTION_DAYS=30

# Rate limits
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
